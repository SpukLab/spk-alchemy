{
  "name": "@spuklab/spk-alchemy",
  "version": "0.1.0",
  "private": true,
  "description": "Spk_Alchemy \u2014 SpukLab Knowledge Graph foundation vertical slice",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "migrate": "node --experimental-strip-types --no-warnings src/cli/main.ts migrate",
    "demo": "node --experimental-strip-types --no-warnings src/cli/main.ts demo",
    "seed": "node --experimental-strip-types --no-warnings src/cli/main.ts seed",
    "queries": "node --experimental-strip-types --no-warnings src/cli/main.ts queries",
    "audit": "node --experimental-strip-types --no-warnings src/cli/main.ts audit",
    "stats": "node --experimental-strip-types --no-warnings src/cli/main.ts stats",
    "test": "node --experimental-strip-types --no-warnings --test tests/conformance/*.test.ts tests/architecture/*.test.ts tests/integration/*.test.ts",
    "explore": "node --experimental-strip-types --no-warnings src/cli/main.ts explore",
    "compare": "node --experimental-strip-types --no-warnings src/cli/main.ts compare",
    "retain": "node --experimental-strip-types --no-warnings src/cli/main.ts retain-preview",
    "discard": "node --experimental-strip-types --no-warnings src/cli/main.ts discard-preview",
    "promote": "node --experimental-strip-types --no-warnings src/cli/main.ts promote",
    "reject": "node --experimental-strip-types --no-warnings src/cli/main.ts reject",
    "corpus": "node --experimental-strip-types --no-warnings src/cli/main.ts corpus",
    "build:web": "node build.mjs",
    "serve": "node --experimental-strip-types --no-warnings -e \"import('./src/cli/serve.ts').then(m=>m.serve())\"",
    "web": "npm run build:web && npm run serve"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5"
  }
}
